APP_NAME="Presensi SPG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://attendance.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------- Face ID / absensi ----------
# engine MITO jalan di server yang sama (systemd faceid-engine, localhost:8090)
FACEID_ENABLED=true
FACE_API_BASE=http://127.0.0.1:8090
# WAJIB diganti! Buat kunci: openssl rand -hex 24
# Halaman absen otomatis nginject key ini ke semua request (header X-Api-Key).
FACEID_API_KEY=GANTI-RANDOM-KEY
# Password halaman /kelola-wajah (Basic Auth admin). WAJIB diganti, mis: openssl rand -base64 24
# Browser akan minta username "admin" + password ini saat buka /kelola-wajah.
FACEID_ADMIN_PASSWORD=GANTI-PASSWORD-ADMIN
# Email akun admin untuk form login (/admin/login). Password-nya pakai FACEID_ADMIN_PASSWORD di atas.
ADMIN_EMAIL=admin@presensi.local
# Radius absen default dari pinpoint toko (meter); dioverride per toko via stores.radius_m
GEO_RADIUS_DEFAULT=150
# Jeda antar absen per karyawan per jenis masuk/pulang (detik)
ATTENDANCE_COOLDOWN=60

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"